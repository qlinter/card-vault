{
  "name": "card-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Local desktop app for managing and showcasing sports cards.",
  "author": "QL",
  "main": "electron/main.js",
  "productName": "card vault",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "prepare:local": "node scripts/prepare-local.js",
    "make:icon": "node scripts/make-icon.js",
    "electron": "electron electron/main.js",
    "dist:win": "npm run make:icon && electron-builder --win nsis dir",
    "db:init": "node scripts/init-db.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.ql.cardvault",
    "productName": "card vault",
    "executableName": "card vault",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      ".next/**/*",
      "app/**/*",
      "components/**/*",
      "electron/**/*",
      "lib/**/*",
      "prisma/**/*",
      "public/**/*",
      "scripts/**/*",
      "next.config.mjs",
      "package.json",
      ".env"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "card-vault-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
