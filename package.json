{
  "name": "card-vault",
  "version": "1.0.13",
  "private": true,
  "description": "Local desktop app for managing and showcasing sports cards.",
  "author": "QL",
  "main": "electron/main.js",
  "productName": "Card Vault",
  "scripts": {
    "build": "next build --webpack",
    "check:encoding": "node scripts/check-encoding.js",
    "test": "node --test tests/*.test.mts tests/*.test.js",
    "test:card": "node scripts/test-card-flow.js",
    "test:share": "node scripts/test-share-flow.js",
    "check:release": "npm run prisma:generate && npm run check:encoding && npm run typecheck && npm test && next build --webpack && npm run test:card && npm run test:share",
    "typecheck": "tsc --noEmit",
    "clean:cache": "node scripts/clean-cache.js",
    "prebuild": "npm run prisma:generate && npm run check:encoding && npm run typecheck",
    "start": "next start",
    "postinstall": "prisma generate",
    "prepare:local": "node scripts/prepare-local.js",
    "make:icon": "node scripts/make-icon.js",
    "preelectron": "npm run prisma:generate",
    "electron": "electron electron/main.js",
    "package:win": "npm run make:icon && electron-builder --win nsis dir",
    "dist:win": "node scripts/release-win.js",
    "release:win": "node scripts/release-win.js",
    "db:init": "node scripts/init-db.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@swc/helpers": "^0.5.15",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.ql.cardvault",
    "productName": "Card Vault",
    "executableName": "Card Vault",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/patch-exe-icon.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      ".next/**/*",
      "!.next/cache/**/*",
      "app/**/*",
      "components/**/*",
      "electron/**/*",
      "build/icon.ico",
      "lib/**/*",
      "prisma/**/*",
      "public/**/*",
      "scripts/**/*",
      "next.config.mjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "card-vault-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
