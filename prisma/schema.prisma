generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id                String      @id @default(cuid())
  playerName        String
  cardTitle         String
  sport             String
  team              String?
  year              String?
  setName           String?
  cardNumber        String?
  isSerialNumbered  Boolean     @default(false)
  serialNumber      String?
  serialRange       String?
  isAutograph       Boolean     @default(false)
  isPatch           Boolean     @default(false)
  gradingCompany    String?
  grade             String?
  gradingLink       String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  gradingFee        Float?
  totalCost         Float?
  currentValue      Float?
  purchaseSource    String?
  tags              String?
  publicDescription String?
  notes             String?
  images            CardImage[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([playerName])
  @@index([cardTitle])
  @@index([sport])
  @@index([team])
  @@index([year])
  @@index([setName])
  @@index([createdAt(sort: Desc)])
}

model CardImage {
  id        String   @id @default(cuid())
  cardId    String
  path      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}
