{
  "name": "card-vault",
  "version": "1.5.3",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Local desktop app for managing and showcasing sports cards.",
  "author": "QL",
  "main": "electron/main.js",
  "productName": "Card Vault",
  "scripts": {
    "build": "next build --webpack",
    "check:encoding": "node scripts/check-encoding.js",
    "check:docs": "node scripts/check-docs.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:metadata": "node scripts/check-release-metadata.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts tests/*.test.js",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=65 --test-coverage-branches=60 --test tests/*.test.mts tests/*.test.js",
    "test:card": "node scripts/test-card-flow.js",
    "test:share": "node scripts/test-share-flow.js",
    "test:security": "node scripts/test-local-session-flow.js",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "check:release": "npm run prisma:generate && npm run check:encoding && npm run check:docs && npm run check:metadata && npm run check:architecture && npm run lint && npm run typecheck && npm run test:coverage && next build --webpack && npm run test:security && npm run test:card && npm run test:share && npm run test:showcase && npm run test:management && npm run test:scout && npm run test:export && npm run test:desktop && npm run test:desktop:ai && npm run test:desktop:collection && npm run test:proxy:pac && npm run test:ui",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "typecheck": "tsc --noEmit",
    "clean:cache": "node scripts/clean-cache.js",
    "prebuild": "npm run prisma:generate && npm run check:encoding && npm run lint && npm run typecheck",
    "start": "next start",
    "postinstall": "prisma generate",
    "prepare:local": "node scripts/prepare-local.js",
    "make:icon": "node scripts/make-icon.js",
    "electron": "electron electron/main.js",
    "package:win": "npm run make:icon && node node_modules/electron/install.js && electron-builder --config scripts/electron-builder.config.js --win nsis",
    "release:win": "node scripts/release-win.js",
    "release:win:package": "node scripts/release-win.js --package-only",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.js",
    "db:init": "node scripts/init-db.js",
    "prisma:generate": "prisma generate",
    "test:management": "node scripts/test-management-flow.js",
    "test:desktop": "node scripts/test-desktop-startup.js",
    "test:desktop:ai": "node scripts/test-ai-settings-desktop.js --development",
    "test:proxy:pac": "node scripts/test-proxy-pac.js",
    "test:desktop:launcher": "node scripts/test-desktop-launcher.js",
    "test:desktop:runtime": "node scripts/test-packaged-desktop.js --development",
    "pretest:desktop:runtime": "npm run build",
    "benchmark:dense": "node scripts/benchmark-dense-history.js",
    "benchmark:data": "node scripts/benchmark-data-workspace.js",
    "benchmark": "node scripts/test-management-flow.js --benchmark",
    "audit:all": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "test:export": "node scripts/test-streaming-export-flow.js",
    "benchmark:export": "node scripts/test-streaming-export-flow.js --benchmark",
    "benchmark:portfolio-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-portfolio-history.mts",
    "benchmark:portfolio-workload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-portfolio-workload.mts",
    "test:scout": "node scripts/test-scout-flow.js",
    "test:showcase": "node scripts/test-showcase-flow.js",
    "test:desktop:collection": "node scripts/test-collection-desktop.js --development"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@swc/helpers": "^0.5.15",
    "archiver": "^5.3.2",
    "exceljs": "^4.4.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "electron": "42.11.18",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.12",
    "deepmerge-ts": "8.0.0",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "com.ql.cardvault",
    "productName": "Card Vault",
    "executableName": "Card Vault",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*",
          "!**/*.tmp*",
          "!**/*.map"
        ]
      },
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/**/*.map",
      "!node_modules/**/*.map",
      "app/**/*",
      "components/**/*",
      "electron/**/*",
      "build/icon.ico",
      "lib/**/*",
      "prisma/**/*",
      "!prisma/*.db*",
      "!prisma/schema-backups/**/*",
      "public/**/*",
      "next.config.mjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "card-vault-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
