generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id                String                @id @default(cuid())
  playerName        String
  cardTitle         String
  sport             String
  team              String?
  year              String?
  brand             String?
  productLine       String?
  subsetName        String?
  parallel          String?
  cardNumber        String?
  isSerialNumbered  Boolean               @default(false)
  serialNumber      String?
  serialRange       String?
  isRookie          Boolean               @default(false)
  isAutograph       Boolean               @default(false)
  autoType          String?
  isPatch           Boolean               @default(false)
  patchType         String?
  gradingCompany    String?
  grade             String?
  certNumber        String?
  gradingLink       String?
  visibility        String                @default("private")
  collectionStatus  String                @default("holding")
  purchaseDate      DateTime?
  purchasePrice     Float?
  gradingFee        Float?
  totalCost         Float?
  currentValue      Float?
  purchaseSource    String?
  tags              String?
  publicDescription String?
  notes             String?
  images            CardImage[]
  transactions      CardTransaction[]
  expenses          CardExpense[]
  valuations        CardValuation[]
  shareItems        ShareCollectionItem[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([playerName])
  @@index([cardTitle])
  @@index([sport])
  @@index([team])
  @@index([year])
  @@index([brand])
  @@index([productLine])
  @@index([parallel])
  @@index([visibility])
  @@index([collectionStatus])
  @@index([createdAt(sort: Desc)])
}

model CardTransaction {
  id          String   @id @default(cuid())
  cardId      String
  kind        String
  amountMinor BigInt
  currency    String   @default("CNY")
  quantity    Int      @default(1)
  occurredAt  DateTime
  source      String?
  notes       String?
  provenance  String
  externalKey String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, occurredAt(sort: Desc)])
  @@index([kind])
  @@index([occurredAt(sort: Desc)])
}

model CardExpense {
  id          String   @id @default(cuid())
  cardId      String
  kind        String
  amountMinor BigInt
  currency    String   @default("CNY")
  occurredAt  DateTime
  vendor      String?
  notes       String?
  provenance  String
  externalKey String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, occurredAt(sort: Desc)])
  @@index([kind])
  @@index([occurredAt(sort: Desc)])
}

model CardValuation {
  id          String   @id @default(cuid())
  cardId      String
  amountMinor BigInt
  currency    String   @default("CNY")
  valuedAt    DateTime
  source      String
  notes       String?
  provenance  String
  externalKey String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, valuedAt(sort: Desc)])
  @@index([valuedAt(sort: Desc)])
}

model CardImage {
  id        String   @id @default(cuid())
  cardId    String
  path      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model CardEntryDraft {
  id            String   @id @default(cuid())
  schemaVersion Int      @default(1)
  status        String   @default("draft")
  valuesJson    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

model CardEntryTemplate {
  id         String    @id @default(cuid())
  name       String    @unique
  valuesJson String
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lastUsedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

model CardEntryBatch {
  id          String               @id @default(cuid())
  label       String?
  pairingMode String               @default("pairs")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CardEntryQueueItem[]

  @@index([createdAt(sort: Desc)])
}

model CardEntryQueueItem {
  id           String                @id @default(cuid())
  batchId      String
  status       String                @default("processing")
  sortOrder    Int                   @default(0)
  attemptCount Int                   @default(0)
  errorMessage String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  batch        CardEntryBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  images       CardEntryQueueImage[]
  recognition  CardEntryRecognition?

  @@index([batchId, sortOrder])
  @@index([status, createdAt])
}

model CardEntryRecognition {
  id             String             @id @default(cuid())
  itemId         String             @unique
  status         String             @default("recognizing")
  suggestionJson String?
  confidenceJson String?
  attemptCount   Int                @default(0)
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  item           CardEntryQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model CardEntryQueueImage {
  id             String             @id @default(cuid())
  itemId         String
  originalName   String
  sourcePath     String?
  processedPath  String?
  side           String             @default("front")
  sortOrder      Int                @default(0)
  mimeType       String
  originalBytes  Int
  processedBytes Int?
  width          Int?
  height         Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  item           CardEntryQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model ShareCollection {
  id                  String                @id @default(cuid())
  title               String
  subtitle            String?
  slug                String                @unique
  theme               String                @default("spotlight")
  presentationConfig  String?
  description         String?
  themeNarrative      String?
  themeHighlights     String?
  groupNotes          String?
  coverImagePath      String?
  backgroundImagePath String?
  sections            ShareSection[]
  items               ShareCollectionItem[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdAt(sort: Desc)])
}

model ShareSection {
  id                String                @id @default(cuid())
  shareCollectionId String
  title             String
  description       String?
  layout            String                @default("editorial")
  sortOrder         Int                   @default(0)
  shareCollection   ShareCollection       @relation(fields: [shareCollectionId], references: [id], onDelete: Cascade)
  items             ShareCollectionItem[]

  @@index([shareCollectionId])
  @@index([sortOrder])
}

model ShareCollectionItem {
  id                 String          @id @default(cuid())
  shareCollectionId  String
  cardId             String
  sectionId          String?
  sortOrder          Int             @default(0)
  displayTitle       String?
  displayDescription String?
  shareCollection    ShareCollection @relation(fields: [shareCollectionId], references: [id], onDelete: Cascade)
  section            ShareSection?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  card               Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([shareCollectionId, cardId])
  @@index([shareCollectionId])
  @@index([sectionId])
  @@index([cardId])
  @@index([sortOrder])
}
