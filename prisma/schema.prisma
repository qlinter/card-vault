generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id                String      @id @default(cuid())
  playerName        String
  cardTitle         String
  sport             String
  team              String?
  year              String?
  brand             String?
  productLine       String?
  subsetName        String?
  parallel          String?
  cardNumber        String?
  isSerialNumbered  Boolean     @default(false)
  serialNumber      String?
  serialRange       String?
  isRookie          Boolean     @default(false)
  isAutograph       Boolean     @default(false)
  autoType          String?
  isPatch           Boolean     @default(false)
  patchType         String?
  gradingCompany    String?
  grade             String?
  certNumber        String?
  gradingLink       String?
  visibility        String      @default("private")
  collectionStatus  String      @default("holding")
  purchaseDate      DateTime?
  purchasePrice     Float?
  gradingFee        Float?
  totalCost         Float?
  currentValue      Float?
  purchaseSource    String?
  tags              String?
  publicDescription String?
  notes             String?
  images            CardImage[]
  shareItems        ShareCollectionItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([playerName])
  @@index([cardTitle])
  @@index([sport])
  @@index([team])
  @@index([year])
  @@index([brand])
  @@index([productLine])
  @@index([parallel])
  @@index([visibility])
  @@index([collectionStatus])
  @@index([createdAt(sort: Desc)])
}

model CardImage {
  id        String   @id @default(cuid())
  cardId    String
  path      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model ShareCollection {
  id             String                @id @default(cuid())
  title          String
  subtitle       String?
  slug           String                @unique
  description    String?
  themeNarrative String?
  themeHighlights String?
  groupNotes     String?
  coverImagePath String?
  items          ShareCollectionItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([createdAt(sort: Desc)])
}

model ShareCollectionItem {
  id                String          @id @default(cuid())
  shareCollectionId String
  cardId            String
  sortOrder         Int             @default(0)
  displayTitle      String?
  displayDescription String?
  shareCollection   ShareCollection @relation(fields: [shareCollectionId], references: [id], onDelete: Cascade)
  card              Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([shareCollectionId, cardId])
  @@index([shareCollectionId])
  @@index([cardId])
  @@index([sortOrder])
}
